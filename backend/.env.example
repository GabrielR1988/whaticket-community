# WhatsApp Provider Configuration
# Supported providers: wwebjs, whaileys
WHATSAPP_PROVIDER=wwebjs

# Logging (silent, fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
WHAILEYS_LOG_LEVEL=error

# Chrome/Puppeteer Configuration
CHROME_BIN=
CHROME_WS=
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox

# Database
DB_HOST=localhost
DB_DIALECT=mysql
DB_PORT=3306
DB_NAME=whaticket
DB_USER=root
DB_PASS=

# JWT Secrets
JWT_SECRET=mysecret
JWT_REFRESH_SECRET=myanothersecret

# Backend URL
BACKEND_URL=http://localhost:8080

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Proxy
PROXY_PORT=8080

# Redis
IO_REDIS_SERVER=127.0.0.1
IO_REDIS_PASSWORD=
IO_REDIS_PORT=6379
IO_REDIS_DB_SESSION=2

# Integracion con EspoCRM (vacio = desactivada)
ESPO_URL=
ESPO_API_KEY=
# Frases que disparan el alta (si el mensaje las CONTIENE); varias separadas por "|"
ESPO_CONTACT_PHRASES=Soy Rodrigo Garrido
ESPO_OPPORTUNITY_PHRASES=me contacto a la brevedad
ESPO_OPPORTUNITY_STAGE=Prospecting
ESPO_CLOSED_STAGES=Closed Won,Closed Lost
ESPO_OPPORTUNITY_CLOSE_DAYS=30
# Usuario de Espo al que se asignan contactos y oportunidades (opcional)
ESPO_ASSIGNED_USER_ID=
