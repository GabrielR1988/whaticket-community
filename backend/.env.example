# WhatsApp Provider Configuration
# Supported providers: wwebjs, whaileys
WHATSAPP_PROVIDER=wwebjs

# Logging (silent, fatal, error, warn, info, debug, trace)
LOG_LEVEL=info
WHAILEYS_LOG_LEVEL=error

# Chrome/Puppeteer Configuration
CHROME_BIN=
CHROME_WS=
CHROME_ARGS=--no-sandbox --disable-setuid-sandbox

# Database
DB_HOST=localhost
DB_DIALECT=mysql
DB_PORT=3306
DB_NAME=whaticket
DB_USER=root
DB_PASS=

# JWT Secrets
JWT_SECRET=mysecret
JWT_REFRESH_SECRET=myanothersecret

# Backend URL
BACKEND_URL=http://localhost:8080

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Proxy
PROXY_PORT=8080

# Redis
IO_REDIS_SERVER=127.0.0.1
IO_REDIS_PASSWORD=
IO_REDIS_PORT=6379
IO_REDIS_DB_SESSION=2

# Integracion con EspoCRM (vacio = desactivada)
ESPO_URL=
ESPO_API_KEY=
# Frases que disparan el alta (si el mensaje las CONTIENE); varias separadas por "|"
ESPO_CONTACT_PHRASES=Soy Rodrigo Garrido
ESPO_OPPORTUNITY_PHRASES=me contacto a la brevedad
ESPO_OPPORTUNITY_STAGE=Prospecting
ESPO_CLOSED_STAGES=Closed Won,Closed Lost
ESPO_OPPORTUNITY_CLOSE_DAYS=30
# Usuario de Espo al que se asignan contactos y oportunidades (opcional)
ESPO_ASSIGNED_USER_ID=

# Integracion con Meta Conversions API (vacio = dry run: solo loguea los eventos)
# Dataset ID (= Pixel ID) del Administrador de eventos
META_DATASET_ID=
# Token de acceso generado en el dataset (Configuracion > Conversions API > Generar token)
META_ACCESS_TOKEN=
# Codigo de "Probar eventos"; dejarlo solo mientras se prueba
META_TEST_EVENT_CODE=
META_API_VERSION=v24.0
# Etiqueta:Evento de Meta, separados por coma (sin tildes ni mayusculas en la etiqueta)
META_TAG_EVENTS=contacto:Lead,venta:Purchase
META_CURRENCY=CLP
# Valor que se informa en cada Purchase (Meta lo exige; 0 si no se quiere informar)
META_PURCHASE_VALUE=0
META_COUNTRY=cl

# WhatsApp Cloud API (numero en coexistencia): alta desde el CRM, webhook y plantillas
# Datos fijos de la App de Meta (developers.facebook.com):
META_APP_ID=
# App Secret: canje del codigo del alta y firma del webhook
META_APP_SECRET=
# ID de configuracion de "Facebook Login for Business" (Embedded Signup + coexistencia)
META_ES_CONFIG_ID=
# Texto cualquiera; el mismo se carga en la config del webhook en Meta
META_WEBHOOK_VERIFY_TOKEN=
# Opcional: solo si NO se conecta desde Conexiones -> "Conectar con Meta"
# (lo guardado desde el CRM tiene prioridad)
META_WHATSAPP_TOKEN=
META_WABA_ID=
META_PHONE_NUMBER_ID=
