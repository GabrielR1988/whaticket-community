# Copiar a .env (no se sube a git). Todo tiene default, esto es para cambiar lo que quieras.
PG_VERSION=16            # usar la misma major (o mayor) que la de Railway
DB_USER=postgres
DB_PASS=postgres
DB_NAME=whaticket
DB_HOST_PORT=5433

JWT_SECRET=cambiame-jwt
JWT_REFRESH_SECRET=cambiame-refresh

BACKEND_URL=http://localhost
BACKEND_PORT=8082
FRONTEND_URL=http://localhost:3333
FRONTEND_PORT=3333

# Quien puede embeber el frontend en un iframe. Local: * ; Railway: la URL de EspoCRM
FRAME_ANCESTORS=*
HOURS_CLOSE_TICKETS_AUTO=
